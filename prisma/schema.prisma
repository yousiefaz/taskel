generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TodoStatus {
  ACTIVE
  COMPLETED
}

model Todo {
  id          String     @id @default(cuid())
  title       String
  description String?
  status      TodoStatus @default(ACTIVE)
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  @@map("todos")
}
